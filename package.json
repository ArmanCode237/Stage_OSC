{
  "name": "free-osc-stage",
  "version": "1.0.0",
  "description": "Aplicación para dispositivos Windows touch para poder usarse como OSC remoto mediante puerto UDP",
  "license": "ISC",
  "author": "ArmandoG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "build": {
    "appId": "com.freeosc.studio",
    "productName": "OSC Stage",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "icon": "src/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
